# Public canonical URL (build time). Use the actual HTTPS origin in production.
PUBLIC_SITE_URL=http://localhost:4321
# Server only. API root including any /api prefix, without a trailing slash.
PHP_CORE_URL=http://127.0.0.1:8080/api
PHP_CORE_API_KEY=
# Host registered in php-core FRANCHISE_CODES, e.g. tram.localhost:tram.
# This is the host, not the franchise code; never take it from a browser header.
PHP_CORE_TENANT_HOST=tram.localhost
# Optional public WebSocket endpoint, never put an API key or bearer token here.
PUBLIC_WEBSOCKET_URL=
# standalone Node binding
HOST=127.0.0.1
PORT=4321
