---
import Icon from "./TransitIcon.astro";
import "../styles/transportMotif.css";
interface Props {
  label?: string;
}
const { label } = Astro.props;
---

<span
  class="transport-motif"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : true}
>
  <span class="transport-motif-vehicle">
    <Icon name="tram" size={19} class="transport-icon" />
  </span>
  <Icon name="arrow" size={19} class="transport-motif-arrow" />
  <span class="transport-motif-vehicle">
    <Icon name="bus" size={19} class="transport-icon" />
  </span>
</span>
