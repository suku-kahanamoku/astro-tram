---
/**
 * Šipka pro prvky `<details>`, která se otáčí podle stavu otevření
 * (rotaci řídí CSS kontext, např. `.language-picker[open]`).
 * Element je dekorativní, proto je skrytý před čtečkami.
 */
interface Props {
  /** Třída navíc pro lokalizaci stavu, např. `language-chevron`. */
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["disclosure-chevron", className]}
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true"
>
  <path
    d="m4 6 4 4 4-4"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
