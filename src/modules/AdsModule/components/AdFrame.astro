---
import "../styles/components.css";
import ReactiveAdFrame from "./AdFrame";
import { site } from "../../../config/site";
import { ads } from "../../../config/ads";
import { dictionary } from "../providers/translations";
import type { Locale } from "../../LangModule/providers/locale";
interface Props {
  locale: Locale;
}
const t = dictionary(Astro.props.locale);
---

{site.modules.ads ? (
  <ReactiveAdFrame
    client:load
    enabled={true}
    units={ads}
    label={t.ad}
    placeholder={t.adSpace}
  >
    <slot />
  </ReactiveAdFrame>
) : (
  <div class="site-frame">
    <div class="site-content">
      <slot />
    </div>
  </div>
)}
