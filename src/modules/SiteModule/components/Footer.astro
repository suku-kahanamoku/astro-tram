---
import { dictionary } from "../providers/translations";
import BrandMark from "./BrandMark.astro";
import { site } from "../../../config/site";
import { url, type Locale } from "../../../config/routes";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props,
  t = dictionary(locale);
---

<footer class="tram-footer shell">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="footer-logo" href={url(locale)} aria-label={site.name}>
        <BrandMark />
        <span>
          {site.name}
          <span class="brand-period" aria-hidden="true">
            .
          </span>
        </span>
      </a>
      <p>{t.common.footer}</p>
    </div>
    <nav class="footer-links" aria-label={t.nav.menu}>
      <a href={url(locale, "search")}>{t.nav.search}</a>
      <a href={url(locale, "about")}>{t.nav.about}</a>
      <a href={url(locale, "licenses")}>{t.nav.licenses}</a>
    </nav>
  </div>
  <div class="footer-bottom">
    <div class="footer-contact">
      <a href={`tel:${site.phone.replace(/[^\d+]/g, "")}`}>{site.phone}</a>
      <span class="footer-divider" aria-hidden="true">
        ·
      </span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span class="footer-divider" aria-hidden="true">
        ·
      </span>
      <span>
        {t.common.registration}: {site.registrationId}
      </span>
    </div>
    <div class="footer-notes">
      <span>
        © {new Date().getFullYear()} {site.name}
      </span>
      <span>{t.common.privacy}</span>
    </div>
  </div>
  <slot />
</footer>
