---
import { dictionary } from "../providers/translations";
import TransportMotif from "../../UIModule/components/TransportMotif.astro";
import type { Locale } from "../../LangModule/providers/locale";
import TravelSteps from "./TravelSteps.astro";
import DiscoverySection from "./DiscoverySection.astro";
import FAQSection from "./FAQSection.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props,
  t = dictionary(locale);
---

<div class="brand-strip">
  <div class="shell">
    <TransportMotif label={t.transportMotif} />
    <p class="brand-strip-copy">
      <strong>{t.stripTitle}</strong>
      <span>{t.stripText}</span>
    </p>
  </div>
</div>
<TravelSteps {locale} />
<DiscoverySection {locale} />
<FAQSection {locale} />
