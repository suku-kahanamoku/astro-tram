---
import { Image } from "astro:assets";
import illustration from "../assets/tram-journey.png";
import { dictionary } from "../providers/translations";
import type { Locale } from "../../LangModule/providers/locale";
import Icon from "../../UIModule/components/TransitIcon.astro";
import { url } from "../../../config/routes";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dictionary(locale);
---

<section class="discovery-section shell">
  <Image
    src={illustration}
    widths={[480, 768, 1024, 1536]}
    sizes="(min-width: 1100px) 640px, (min-width: 768px) 50vw, 100vw"
    format="webp"
    quality={80}
    alt={t.featureAlt}
    width="1536"
    height="1024"
    loading="lazy"
  />
  <div>
    <span class="eyebrow">{t.featureTag}</span>
    <h2>{t.featureTitle}</h2>
    <p>{t.featureText}</p>
    <a class="text-link" href={url(locale, "search")}>
      {t.cta}
      <Icon name="arrow" />
    </a>
  </div>
</section>
