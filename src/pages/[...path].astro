---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../modules/LandingModule/components/HeroSection.astro";
import Story from "../modules/LandingModule/components/StorySections.astro";
import Search from "../modules/TransportModule/components/Search.astro";
import Login from "../modules/AuthModule/components/Login.astro";
import Account from "../modules/AuthModule/components/Account.astro";
import DataLicenses from "../modules/TransportModule/components/DataLicenses.astro";
import SoftwareLicenses from "../modules/SiteModule/components/SoftwareLicenses.astro";
import { dictionary as siteDictionary } from "../modules/SiteModule/providers/translations";
import "../modules/TransportModule/styles/attributions.css";
import { dictionary as authDictionary } from "../modules/AuthModule/providers/translations";
import { dictionary } from "../modules/LandingModule/providers/translations";
import { dictionary as transportDictionary } from "../modules/TransportCoreModule/providers/translations";
import { locales, pages, resolveRoute, url } from "../config/routes";
import { localeFromPath } from "../modules/LangModule/providers/locale";
import { site } from "../config/site";
export const prerender = true;
export function getStaticPaths() {
  return locales.flatMap((locale) =>
    pages.map((page) => ({
      params: { path: url(locale, page).slice(1, -1) || undefined },
    })),
  );
}
const route = resolveRoute(Astro.url.pathname),
  locale = route?.locale ?? localeFromPath(Astro.url.pathname),
  page = route?.page;
const t = dictionary(locale),
  search = transportDictionary(locale);
const error = !route;
const auth = authDictionary(locale);
const licenses = siteDictionary(locale).licenses;
if (error) Astro.response.status = 404;
if (page === "search" || page === "account" || page === "login") {
  Astro.locals.privatePage = true;
  Astro.locals.sameOriginForms = page === "login" || page === "account";
  Astro.response.headers.set("Cache-Control", "private, no-store");
  Astro.response.headers.set("Referrer-Policy", "no-referrer");
}
---

<BaseLayout
  {locale}
  page={error ? undefined : page}
  title={
    page === "licenses"
      ? licenses.title
      : error
        ? "404"
        : page === "login"
          ? auth.auth.title
          : page === "account"
            ? auth.auth.account
            : page === "search"
              ? search.results
              : page === "about"
                ? t.navAbout
                : `${t.title1} ${t.title2}`
  }
  description={page === "licenses" ? licenses.intro : t.intro}
  noindex={error || page === "search" || page === "login" || page === "account"}
>
  {error ? (
    <section class="shell simple-page">
      <span class="eyebrow">404</span>
      <h1>{site.name} / 404</h1>
      <a class="button" href={url(locale)}>
        {t.cta} →
      </a>
    </section>
  ) : page === "login" ? (
    <Login {locale} />
  ) : page === "account" ? (
    <Account {locale} />
  ) : page === "licenses" ? (
    <section class="shell simple-page licenses-page">
      <span class="eyebrow">{site.name}</span>
      <h1>{licenses.title}</h1>
      <p>{licenses.intro}</p>
      <DataLicenses {locale} />
      <SoftwareLicenses {locale} />
    </section>
  ) : page === "home" ? (
    <>
      <div class="home-intro">
        <Hero {locale} />
        <Search {locale} />
      </div>
      <Story {locale} />
    </>
  ) : page === "search" ? (
    <Search {locale} results />
  ) : (
    <>
      <section class="shell simple-page">
        <span class="eyebrow">{site.name}</span>
        <h1>{t.aboutTitle}</h1>
        <p>{t.aboutText}</p>
        <a class="button" href={url(locale, "search")}>
          {t.cta} →
        </a>
      </section>
      <Story {locale} />
    </>
  )}
</BaseLayout>
